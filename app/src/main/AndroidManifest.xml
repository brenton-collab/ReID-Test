<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application android:allowBackup="false" android:icon="@drawable/ic_fintrac_id" android:label="Relay Capture" android:supportsRtl="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <service android:name=".ProjectionService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <activity android:name=".ScreenshotActivity" android:exported="false" android:label="Relay Screenshot" />
        <activity android:name=".CaptureActivity" android:exported="false" android:label="Relay Capture Camera" />
        <activity android:name=".MainActivityV123" android:exported="true" android:launchMode="singleTop" android:label="Relay Capture">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="image/*" /><data android:mimeType="application/pdf" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.SEND_MULTIPLE" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="image/*" /><data android:mimeType="application/pdf" /></intent-filter>
        </activity>
    </application>
</manifest>
